---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { url } from '../lib/url';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const home = (await getEntry('home', 'home'))!.data;
const needs = (await getCollection('needs')).sort(byOrder);
const myTools = (await getCollection('myTools')).sort(byOrder);
const bodyMind = (await getCollection('bodyMind')).sort(byOrder);
---
<Base current="home">
  <div slot="intro" class="bg-sky">
    <div class="page pt-8.5 pb-9.5">
      <h1 class="max-w-[17ch] font-display text-display font-semibold tracking-tight">
        {home.title}
      </h1>
      <p class="mt-3.5 max-w-[40ch] text-lead">
        {home.lead}
      </p>
    </div>
  </div>

  <section class="page pt-10" aria-labelledby="needs-h">
    <h2 id="needs-h" class="font-display text-h2 font-semibold">{home.needs.heading}</h2>
    <p class="mt-1.5 mb-4.5 text-ink-2">{needs.length} {home.needs.subtitle}</p>
    <ul class="md:columns-2 md:gap-12">
      {
        needs.map((need) => (
          <li class="break-inside-avoid">
            <a
              href={url(`/needs/${need.id}`)}
              class="group flex items-center gap-3.5 border-b border-line py-3 no-underline"
            >
              <Tile icon={need.data.icon} color={need.data.color} />
              <span>
                <span class="block font-display text-title font-medium transition-colors group-hover:text-go">
                  {need.data.title}
                </span>
                <span class="block text-small text-ink-2">{need.data.summary}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page pt-10" aria-labelledby="mine-h">
    <h2 id="mine-h" class="font-display text-h2 font-semibold">{home.myTools.heading}</h2>
    <p class="mt-1.5 mb-4.5 text-ink-2">{home.myTools.subtitle}</p>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {
        myTools.map((tool) => (
          <li>
            <a
              href={url(tool.data.href)}
              class="flex h-full flex-col gap-2.5 rounded-card border-2 border-line p-4 no-underline transition-colors hover:border-ink"
            >
              <Tile icon={tool.data.icon} color={tool.data.color} />
              <span>
                <span class="block font-display text-card font-medium">{tool.data.title}</span>
                <span class="block text-small text-ink-2">{tool.data.summary}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page pt-10" aria-labelledby="bm-h">
    <h2 id="bm-h" class="font-display text-h2 font-semibold">{home.bodyMind.heading}</h2>
    <p class="mt-1.5 mb-4.5 text-ink-2">{home.bodyMind.subtitle}</p>
    <ul class="flex flex-wrap justify-center gap-y-4">
      {
        bodyMind.map((item) => (
          <li class="min-w-0 basis-1/3 px-1 xs:basis-1/5 md:px-2">
            <a
              href={url(`/body-mind/${item.id}`)}
              class="group flex flex-col items-center gap-2 py-1.5 text-center text-small leading-tight font-bold break-words no-underline md:text-body"
            >
              <span class="flex w-full max-w-15 justify-center rounded-app outline-2 outline-offset-2 outline-transparent transition-[outline-color] group-hover:outline-ink md:max-w-19 md:rounded-app-lg">
                <Tile icon={item.data.icon} color={item.data.color} size="app" />
              </span>
              {item.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
