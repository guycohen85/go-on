---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopicPage from '../components/TopicPage.astro';

// The page's title and summary live in the intro section of src/content/topics/privacy/.
const page = (await getEntry('sections', 'privacy/00-intro'))!.data;
---
<Base title={page.title}>
  <TopicPage topic="privacy" title={page.title!} summary={page.summary} icon={page.icon} color="blue" feedback={false} accordion={false} />
</Base>
