---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopicPage from '../../components/TopicPage.astro';

export async function getStaticPaths() {
  const needs = await getCollection('needs');
  return needs.map((need) => ({ params: { slug: need.id }, props: { need } }));
}

interface Props {
  need: CollectionEntry<'needs'>;
}
const { need } = Astro.props;
---
<Base title={need.data.title} description={need.data.summary}>
  <TopicPage
    topic={need.id}
    title={need.data.title}
    summary={need.data.summary}
    icon={need.data.icon}
    color={need.data.color}
  />
</Base>
