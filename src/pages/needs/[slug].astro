---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';

export async function getStaticPaths() {
  const needs = await getCollection('needs');
  return needs.map((need) => ({ params: { slug: need.id }, props: { need } }));
}

interface Props {
  need: CollectionEntry<'needs'>;
}
const { need } = Astro.props;
---
<Base title={need.data.title} description={need.data.summary}>
  <Placeholder title={need.data.title} milestone={2} />
</Base>
