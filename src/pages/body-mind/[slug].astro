---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopicPage from '../../components/TopicPage.astro';

export async function getStaticPaths() {
  const items = await getCollection('bodyMind');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props {
  item: CollectionEntry<'bodyMind'>;
}
const { item } = Astro.props;
---
<Base title={item.data.title}>
  <TopicPage topic={item.id} title={item.data.title} icon={item.data.icon} color={item.data.color} />
</Base>
