---
// Temporary page body for routes whose content arrives in a later milestone.
interface Props {
  title: string;
  milestone: number;
}
const { title, milestone } = Astro.props;
---
<section class="page pt-8">
  <h1 class="font-display text-h2 font-semibold">{title}</h1>
  <p class="mt-3 text-ink-2">[חסר: התוכן של העמוד הזה ייבנה באבן דרך {milestone}]</p>
  <slot />
</section>
