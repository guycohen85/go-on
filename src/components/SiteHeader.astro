---
import Icon from './Icon.astro';
import SiteMenu from './SiteMenu.astro';
import { url } from '../lib/url';
---
<header class="page flex flex-wrap items-center justify-between gap-x-2 py-3.5">
  <a href={url('/')} class="flex min-h-11 shrink-0 items-center no-underline" aria-label="GO ON, לדף הבית">
    <img src={url('/logo-go-on.png')} alt="" width="134" height="36" class="h-8 w-auto xs:h-9" />
  </a>
  <div class="flex items-center gap-1">
    <a
      href={url('/safety')}
      class="inline-flex min-h-11 items-center gap-1.5 rounded-pill bg-sky px-3.5 text-small font-bold whitespace-nowrap no-underline"
    >
      <span class="hidden xs:contents"><Icon name="lifebuoy" weight="bold" /></span>
      צריך עזרה עכשיו?
    </a>
    <button
      type="button"
      class="grid size-11 cursor-pointer place-items-center rounded-pill text-icon transition-colors hover:bg-sky"
      aria-label="תפריט"
      aria-haspopup="dialog"
      aria-controls="site-menu"
      data-menu-open
    >
      <Icon name="list" weight="bold" />
    </button>
  </div>
</header>
<SiteMenu />
