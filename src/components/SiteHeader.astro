---
import Icon from './Icon.astro';
import { url } from '../lib/url';
---
<header class="page flex items-center justify-between py-3.5">
  <a href={url('/')} class="flex min-h-11 items-center gap-2 font-display text-card font-semibold no-underline" aria-label="GO ON, לדף הבית">
    <img src={url('/logo.svg')} alt="" width="38" height="38" class="size-9.5" />
    <span aria-hidden="true">GO ON</span>
  </a>
  <a
    href={url('/safety')}
    class="inline-flex min-h-11 items-center gap-1.5 rounded-pill bg-sky px-3.5 text-small font-bold no-underline"
  >
    <Icon name="lifebuoy" weight="bold" />
    צריך עזרה עכשיו?
  </a>
</header>
